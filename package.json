{
  "name": "lunio-design-system",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run tokens:build && npm run tokens:check && npm run shadcn:check && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node --test tests/tokens.test.mjs",
    "logos:build": "python3 scripts/generate-brand-logos.py",
    "check": "npm run tokens:check && npm run shadcn:check && npm run typecheck",
    "shadcn:check": "node --test tests/shadcn.test.mjs",
    "ui:add": "npx shadcn@latest add"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "description": "Lunio Design System — Next.js 16 + genuine shadcn/ui (Radix) + MiSansTC + multi-brand tokens"
}
